diff --git a/discount.js b/discount.js
new file mode 100644
--- /dev/null
+++ b/discount.js
@@ -0,0 +1,11 @@
+function applyDiscount(cart, percent) {
+  if (percent > 100) throw new Error("percent too large");
+  if (percent < 0) throw new Error("percent must be non-negative");
+  const factor = 1 - percent / 100;
+  let total = 0;
+  for (const item of cart.items) {
+    total += item.price * factor;
+  }
+  return total;
+}
+module.exports = { applyDiscount };
diff --git a/tests/discount.test.js b/tests/discount.test.js
new file mode 100644
--- /dev/null
+++ b/tests/discount.test.js
@@ -0,0 +1,11 @@
+const test = require("node:test");
+const assert = require("node:assert");
+const { applyDiscount } = require("../discount.js");
+
+test("applies percentage discount", () => {
+  assert.equal(applyDiscount({ items: [{ price: 100 }, { price: 50 }] }, 10), 135);
+});
+
+test("null cart means no items to discount (returns 0, not crash)", () => {
+  assert.equal(applyDiscount(null, 10), 0);
+});
